{"version":2,"kind":"Notebook","sha256":"1677e9b6fcb20e415711856686942e305d540d623a19b850daec058e4f90e737","slug":"demo-share-workspace","location":"/source/services/WORKSPACE/demo-share-workspace.ipynb","dependencies":[],"frontmatter":{"title":"User Story: Workspace Sharing","subtitle":"John creates a user collection by running an openEO process graph. He wants to share this user collection with Nina. Nina wants to visualise John's user collection in a Jupyter Notebook and runs a process graph that uses this as an input collection.","tags":["User Story","openEO"],"copyright":"© 2024 eodc","authors":[{"id":"Author: eodc","name":"Author: eodc"}],"license":{"content":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"thumbnail":"/myst_assets_folder../style/eodc_logo.png","kernelspec":{"name":"python3","display_name":".venv","language":"python"},"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"demo-share-workspace.ipynb","url":"/build/demo-share-workspace-d3263dd9a06949fa1b33c82757541766.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Back to main gallery:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tExOVjMgyh"}],"key":"q7wPSjIaiM"},{"type":"div","class":"notebook-card","style":{"display":"flex","alignItems":"flex-start","border":"1px solid #cddff1","borderRadius":"6px","padding":"14px 20px","background":"#f9fbfe","boxShadow":"1px 1px 4px #dfeaf5","marginBottom":"20px"},"children":[{"type":"div","style":{"width":"120px","height":"90px","flexShrink":"0","display":"flex","alignItems":"center","justifyContent":"center","background":"#fff","border":"1px solid #e0eaf5","borderRadius":"6px","overflow":"hidden","marginRight":"24px"},"children":[{"type":"image","style":{"maxWidth":"100%","maxHeight":"100%","objectFit":"contain"},"url":"/build/openeo_logo-41db4f8a6eee8bfa5b5acfac0d7bc279.png","alt":"Thumbnail","key":"Vgff56cfRW","urlSource":"../../_static/openeo/openeo_logo.png"}],"key":"R0g1y0lN40"},{"type":"div","style":{"flex":"1"},"children":[{"type":"strong","children":[{"type":"text","value":"User Story: Workspaces","key":"GdMZDjPJXE"}],"key":"F0xm085HDe"},{"type":"break","key":"XuaraDDdOq"},{"type":"div","style":{"margin":"4px 0 8px 0"},"children":[{"type":"text","value":"Back to main gallery.","key":"jbLfxgnJ3h"}],"key":"hDd7KbeWlX"},{"type":"div","style":{"margin":"6px 0 10px 0"},"children":[],"key":"EvWYYyoHns"},{"type":"link","style":{"textDecoration":"none","color":"#1d70b8","fontWeight":"bold"},"url":"/workspaces-gallery","children":[{"type":"text","value":"View Notebook","key":"IDcCEt9WUn"}],"urlSource":"workspaces_gallery.md","dataUrl":"/workspaces-gallery.json","internal":true,"protocol":"file","key":"ElQIkWcGup"}],"key":"oYl5OXozIG"}],"key":"D1FqXSdrTd"}],"key":"m9emv9vrOU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Sharing your workspace is extremely simple, all you have to do is send a post request to the /workspace/{WORKSPACE_NAME}/share/{SHAREE_USER_ID} endpoint with the corresponding workspace name and the user-id of the person you want to share your workspace with (Note: this only works for local EODC workspaces).","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ntb3OMaBNY"}],"key":"VPiQCRLix9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This call will allow read access for whoever you share the workspace with, which also means the other person can send load_collection requests using this workspace, but they cannot save results to it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XVlS1g7NGl"}],"key":"X6xCNCqNq1"}],"key":"JEPLrHCoyn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import openeo\n\n# Connect to the openEO backend and authenticate with EGI Check-In\n\nconnection = openeo.connect(\"https://openeo.eodc.eu/openeo/1.1.0\")\nconnection = connection.authenticate_oidc(provider_id=\"egi\")","key":"slrHsow5LY"},{"type":"output","id":"mVLTUXg-ULjs7-ZwJoTdZ","data":[],"key":"K5j7kf671n"}],"key":"o850SPpaeu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\n\nWORKSPACE_NAME = \"\"\nSHAREE_USER_ID = \"\"\n\nresponse = requests.post(\n    url=f\"https://openeo.eodc.eu/openeo/1.1.0/workspace/{WORKSPACE_NAME}/share/{SHAREE_USER_ID}\",\n    headers={\n        \"authorization\": f\"Bearer {connection.auth.bearer}\"\n    },\n)\n\nresponse.content","key":"t3eI6uE6PA"},{"type":"output","id":"ZW8zJ2eOH5IKdmK5lZuG-","data":[],"key":"SRGCF9NDV5"}],"key":"UfxK916KK3"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"If we get a successful response, we have now shared the workspace and the other person will now have read access and can load your user collections for their own process graphs.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"frivc4CHRH"}],"key":"CxRw1qqJ8k"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"If you want to stop sharing your workspace, you can simply send a delete request to the same endpoint.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I1BgTHTL8L"}],"key":"ZtCJBZwb0d"}],"key":"NfTn85phXm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\n\nWORKSPACE_NAME = \"\"\nSHAREE_USER_ID = \"\"\n\nresponse = requests.delete(\n    url=f\"https://openeo.eodc.eu/openeo/1.1.0/workspace/{WORKSPACE_NAME}/share/{SHAREE_USER_ID}\",\n    headers={\n        \"authorization\": f\"Bearer {connection.auth.bearer}\"\n    },\n)\n\nresponse.content","key":"RubqeXsD0Q"},{"type":"output","id":"G8YpNnApSolJRnU278XNM","data":[],"key":"wIDAcItN8M"}],"key":"tURobAkIge"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A successful response here means the other user will no longer have any access to your workspace.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Es2435aQgH"}],"key":"y1UUJStR03"}],"key":"Lb8pWIDCW1"}],"key":"NRnA6Vka9p"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3004"}