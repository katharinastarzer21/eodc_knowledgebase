nEO backend and authenticate with EGI Check-In\n\nconnection = openeo.connect(\"https://openeo.eodc.eu/openeo/1.1.0\")\nconnection = connection.authenticate_oidc(provider_id=\"egi\")","key":"DYd9HwFiDI"},{"type":"output","id":"aCZyjy2qy9ny3M5JKznq6","data":[],"key":"ttegs5jx6c"}],"key":"YwdnCoJM0p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\n\nresponse = requests.get(\n    url=f\"https://openeo.eodc.eu/openeo/1.1.0/workspace/{WORKSPACE_NAME}/files\",\n    headers={\n        \"authorization\": f\"Bearer {connection.auth.bearer}\"\n    },\n)\n\nresponse.content.decode()","key":"l721xApbhh"},{"type":"output","id":"StFahlamCa2lgLu-LKFk0","data":[],"key":"I7a9smkMiD"}],"key":"XX1ocC6VHd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2) WorkspaceAdapter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pYZqoOp7nq"}],"identifier":"id-2-workspaceadapter","label":"2) WorkspaceAdapter","html_id":"id-2-workspaceadapter","implicit":true,"key":"Vpg63flG96"}],"key":"hkJTjZ2h7f"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In order to use the workspace adapter we instantiate a WorkspaceAdapter using the create_adapter function and passing all relevant credentials for our workspace.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OACWkdngib"}],"key":"bD9mPhTAji"}],"key":"oWskzhKh9T"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"(optional) Retrieve local workspace credentials","position":{"start":{"line":1,"column":1},"end":{