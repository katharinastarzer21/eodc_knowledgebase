sition":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Write-Access","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"dEAHwsVmn7"}],"identifier":"write-access","label":"Write-Access","html_id":"write-access","implicit":true,"key":"OTnPVub3Pi"},{"type":"code","lang":"JSON","value":"\"Action\": [\n    \"s3:ListBucket\",\n    \"s3:GetObject\",\n    \"s3:PutObject\"\n],","position":{"start":{"line":103,"column":1},"end":{"line":109,"column":1}},"key":"E4xLdlMgk3"},{"type":"heading","depth":3,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"Delete Policy","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"dkSnMd0oP6"}],"identifier":"delete-policy","label":"Delete Policy","html_id":"delete-policy","implicit":true,"key":"ewreFeMRDl"},{"type":"code","lang":"sh","value":"s3cmd delpolicy s3://BUCKET","position":{"start":{"line":113,"column":1},"end":{"line":115,"column":1}},"key":"VJDBMrz0OA"},{"type":"heading","depth":3,"position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Example S3cmd","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"izNUuY6ILW"}],"identifier":"example-s3cmd","label":"Example S3cmd","html_id":"example-s3cmd","implicit":true,"key":"KczG3TTZx2"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"The following example sets a bucket policy for an anonymous User to READ.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"GlMucjf8HH"}],"key":"XUCPEOOtqD"},{"type":"code","lang":"JSON","value":"{\n    \"Version\": \"2012-10-17\",\n    \"Statement\": [\n        {\n            \"Sid\": \"PublicBucket\",\n            \"Effect\": \"Allow\",\n            \"Principal\": \"*\",\n            \"Action\": [\n                \"s3:ListBucket\",\n                \"s3:GetObject\"\n            ],\n            \"Resource\": [\n                \"arn:aws:s3:::BUCKET-NAME\"\n            ]\n        }\n    ]\n}","position":{"start":{"line":121,"column":1},"end":{"line":139,"column":1}},"key":"LATTxpazPj"},{"type":"code","lang":"sh","value":"s3cmd setpolicy acl.json s3://BUCKET","position":{"start":{"line":141,"column":1},"end":{"line":143,"column":1}},"key":"bwbASTpzYE"},{"type":"code","lang":"sh","value":"s3cmd info s3://BUCKET","position":{"start":{"line":144,"column":1},"end":{"line":146,"column":1}},"key":"cIJRGT3czU"},{"type":"comment","value":"\n## [boto3](https://boto3.amazonaws.com/v1/documentation/api/latest/index.html) <a name=\"boto3\"></a>\n\n### Configure s3 client\n\n```python\nimport boto3\n\nACCESS_KEY = os.getenv(\"ACCESS_KEY\")\nSECRET_KEY = os.getenv(\"SECRET_KEY\")\nREGION_NAME = \"US\"\nENDPOINT_URL = \"https://objectstore.eodc.eu:2222\"\nBUCKET = \"bucket-name\"\n\ns3 = boto3.client('s3', aws_access_key_id=ACCESS_KEY, aws_secret_access_key=SECRET_KEY,\n                             region_name=REGION_NAME, endpoint_url=ENDPOINT_URL)\n\n```\n\n### Retrieve bucket policy boto3\n\n```python\nresult = s3.get_bucket_policy(Bucket='BUCKET_NAME')\nprint(result['Policy'])\n```\n\n### Set Policy boto3 \n\n```python\nimport json\n\n# Create a bucket policy\nbucket_name = 'BUCKET_NAME'\nbucket_policy = {\n    \"Version\": \"2012-10-17\",\n    \"Statement\": [\n        {\n            \"Sid\": \"PublicBucket\",\n            \"Effect\": \"Allow\",\n            \"Principal\": \"*\",\n            \"Action\": [\n                \"s3:ListBucket\",\n                \"s3:GetObject\"\n            ],\n            \"Resource\": [\n                \"arn:aws:s3:::BUCKET-NAME\"\n            ]\n        }\n    ]\n}\n\n# Convert the policy from JSON dict to string\nbucket_policy = json.dumps(bucket_policy)\n\ns3.put_bucket_policy(Bucket=bucket_name, Policy=bucket_policy)\n```\n\n\n\n\n### Set Bucket acl's to Public-Read\n\n```sh\ns3cmd setacl s3://bucket --acl-public\n```\n\nWith this command anyone can list the bucket. It is important to mention that at this stage the downloading of Objects is still prohibited.\nIf you want to set the Contents to Public as well, you will have to set the Acl for each object individually.\n\n```cmd\ns3cmd setacl s3//bucket/object-key --acl-public\n```\n\"\"\"\n","key":"ypkApnfMvl"}],"key":"FL1lCtVwdD"}],"key":"hnHbyupwd0"},"references":{"cite":{"order":[],"data":{}}}}