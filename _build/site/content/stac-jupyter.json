yter.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ahn5VC6TZy"}],"key":"oPRToB1EUy"},{"type":"heading","depth":2,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"1. Discover Data via the STAC API","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"JZ1c1iaHd7"}],"identifier":"id-1-discover-data-via-the-stac-api","label":"1. Discover Data via the STAC API","html_id":"id-1-discover-data-via-the-stac-api","implicit":true,"key":"drxDEbvAQc"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"J9U5ysmLHc"},{"type":"link","url":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_DataDiscovery.ipynb","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"first notebook","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ewrgUzGXuc"}],"urlSource":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_DataDiscovery.ipynb","data":{"kind":"file","org":"eodcgmbh","repo":"eodc-examples","reference":"main","file":"demos/python-stac_DataDiscovery.ipynb","raw":"https://raw.githubusercontent.com/eodcgmbh/eodc-examples/main/demos/python-stac_DataDiscovery.ipynb"},"internal":false,"protocol":"github","key":"ZrfVHnWcgg"},{"type":"text","value":" explains how to connect to the STAC catalog and how to load and discover data.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"artVuL3EvS"}],"key":"gF6UpKR8Gw"},{"type":"heading","depth":3,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Searching for STAC collections and items","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"sKbHxKOHNT"}],"identifier":"searching-for-stac-collections-and-items","label":"Searching for STAC collections and items","html_id":"searching-for-stac-collections-and-items","implicit":true,"key":"LhPQIsePeS"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The pystac_client can be used to access the STAC catalog of the EODC directly. This has the great advantage that the data does not have to be downloaded locally and then loaded into the notebook, but can be processed immediately.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"xb7TZhAXIt"}],"key":"pptxcc1Dem"},{"type":"code","lang":"","value":"eodc_catalog = Client.open(\n    \"https://stac.eodc.eu/api/v1\",\n)","position":{"start":{"line":29,"column":1},"end":{"line":33,"column":1}},"key":"Zb5r1ikq0G"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"You can search for single, multiple or all collections with .get_collection()","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"L9wgnVbhu6"}],"key":"C4M15xA8BD"},{"type":"code","lang":"","value":"collection = eodc_catalog.get_collection(\"SENTINEL2_L1C\")","position":{"start":{"line":37,"column":1},"end":{"line":39,"column":1}},"key":"SAJoY2TuOp"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"With the .get_all_items() function you get all items of the selected collection. You can then search the items for properties such as cloud coverage.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"TTT8PgQH0M"}],"key":"LLekYgL0Qq"},{"type":"code","lang":"","value":"items = collection.get_all_items()","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"key":"x6ftmhfyWr"},{"type":"heading","depth":3,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Searching for items in a collection with filter criterias","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"DCyGjT77F4"}],"identifier":"searching-for-items-in-a-collection-with-filter-criterias","label":"Searching for items in a collection with filter criterias","html_id":"searching-for-items-in-a-collection-with-filter-criterias","implicit":true,"key":"OW91Wl0dTO"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"As in the web STAC catalog, the data can be filtered according to temporal and spatial extent. We define the spatial extent with the help of GeoJSON (or a bounding box) and the temporal extent with a time range.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"d6Hs1c2JWK"}],"key":"gVnB1m5eAd"},{"type":"code","lang":"","value":"time_range = \"2023-05-01/2024-05-01\"\n\n# Area around the Neusiedler See\narea_of_interest = {\n\"coordinates\": [\n          [\n            [\n              16.685331259653253,\n              48.001346032803355\n            ],\n            [\n              16.621884871275512,\n              47.902601630022275\n            ],\n            [\n              16.62588718725482,\n              47.81041047247777\n            ],\n            [\n              16.664809254423375,\n              47.774602171781936\n            ],\n            [\n              16.96808652311867,\n              47.76771348708101\n            ],\n            [\n              16.963971948548988,\n              48.00956486424042\n            ],\n            [\n              16.685331259653253,\n              48.001346032803355\n            ]\n          ]\n        ],\n        \"type\": \"Polygon\"\n      }\n","position":{"start":{"line":51,"column":1},"end":{"line":91,"column":1}},"key":"z6hwnZjr0q"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Then we can search for Sentinel-2 data (from our collection above), that matches our filter criteria and save them in a item collection. The notebook also describes how to display the assets of an item in a table.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"cfwkzhgsQ8"}],"key":"wAWczR7AN0"},{"type":"code","lang":"","value":"search = eodc_catalog.search(\n    collections=[\"SENTINEL2_L1C\"],\n    intersects=area_of_interest,\n    #bbox = bbox_aut,\n    datetime=time_range\n)\n\nitems_eodc = search.item_collection()","position":{"start":{"line":95,"column":1},"end":{"line":104,"column":1}},"key":"QQwihdatVu"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Here, too, we can search for the item with the lowest cloud cover, for example, and then plot it.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"u1Zhipkhrz"}],"key":"FHhMKiPwcY"},{"type":"code","lang":"","value":"selected_item = min(items_eodc, key=lambda item: item.properties[\"eo:cloud_cover\"])\n\nImage(url=selected_item.assets[\"thumbnail\"].href, width=500)","position":{"start":{"line":108,"column":1},"end":{"line":112,"column":1}},"key":"uGz0OCoXU8"},{"type":"image","url":"/STAC_Thumbnail-7aa0a692b805ab4a25ca16a7cf8df6f8.png","alt":"image","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"zBd9frmt8z","urlSource":"../../_static/stac/STAC_Thumbnail.png"},{"type":"heading","depth":2,"position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"2. Analyzing STAC Metadata","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"Hk37vrLBOS"}],"identifier":"id-2-analyzing-stac-metadata","label":"2. Analyzing STAC Metadata","html_id":"id-2-analyzing-stac-metadata","implicit":true,"key":"BAvbiFAVoJ"},{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"fQB5p8YLXN"},{"type":"link","url":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_AnalyzingMetadata.ipynb","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"second notebook","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"Q7pRSGMxkr"}],"urlSource":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_AnalyzingMetadata.ipynb","data":{"kind":"file","org":"eodcgmbh","repo":"eodc-examples","reference":"main","file":"demos/python-stac_AnalyzingMetadata.ipynb","raw":"https://raw.githubusercontent.com/eodcgmbh/eodc-examples/main/demos/python-stac_AnalyzingMetadata.ipynb"},"internal":false,"protocol":"github","key":"dKS9ZE1g7e"},{"type":"text","value":" is about analysing the metadata.","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"lM3IP2n9ut"}],"key":"LRhLgfHqyq"},{"type":"heading","depth":3,"position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"Rolling average of the cloud-cover","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"Z9mX7ykGl3"}],"identifier":"rolling-average-of-the-cloud-cover","label":"Rolling average of the cloud-cover","html_id":"rolling-average-of-the-cloud-cover","implicit":true,"key":"yV2TGf7KFX"},{"type":"paragraph","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"First, you can create a rolling average of the cloud cover over Austria of Sentinel-2 in a specific time range. For this, we use a geodataframe.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"gAjp7uGfDs"}],"key":"B02MVIvdzq"},{"type":"code","lang":"","value":"df = geopandas.GeoDataFrame.from_features(items.to_dict())\ndf[\"datetime\"] = pd.to_datetime(df[\"datetime\"])\n\nts = df.set_index(\"datetime\").sort_index()[\"eo:cloud_cover\"].rolling(7).mean()\nts.plot(title=\"eo:cloud-cover (7-scene rolling average)\");","position":{"start":{"line":126,"column":1},"end":{"line":132,"column":1}},"key":"rOhhSm0nzn"},{"type":"image","url":"/STAC_cc-fb759007e3f4ded7cda3289b92e1a512.png","alt":"image","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"GAHS3aQcPu","urlSource":"../../_static/stac/STAC_cc.png"},{"type":"paragraph","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"We can see, that in this example there is no data from November and December.","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"JdB1llF4IB"}],"key":"l3x4vPgmGi"},{"type":"heading","depth":3,"position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"Visualize the data coverage","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"zLQxGOJou6"}],"identifier":"visualize-the-data-coverage","label":"Visualize the data coverage","html_id":"visualize-the-data-coverage","implicit":true,"key":"F6TtsDDIyP"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Another way to analyse our data is to visualize, for example, the Sentinel-2 L1C data over Europe. So we need to search for the Sentinel-2 items within the spatial extent of europe.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"gliTxQ5thn"}],"key":"b13u8qPOnB"},{"type":"code","lang":"","value":"bbox_eu = [-63.151187329826996,\n -21.349632697207902,\n 55.834818182891276,\n 70.09213659004354]\n\ntime_range_eu = \"2024-03-01/2024-04-01\"\n\nsearch_eu = eodc_catalog.search(\n    collections=[\"SENTINEL2_L1C\"],\n    bbox = bbox_eu,\n    datetime=time_range_eu\n)\nitems_eu = search_eu.item_collection()","position":{"start":{"line":143,"column":1},"end":{"line":157,"column":1}},"key":"ipvyi4yzxL"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"Then, we can create a map with all found items over Europe.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"kvRhX85eEa"}],"key":"pdMdj9w9Ho"},{"type":"code","lang":"","value":"df = geopandas.GeoDataFrame.from_features(items_eu.to_dict())\n\nworld = geopandas.read_file(\"./data/world-administrative-boundaries/world-administrative-boundaries.shp\")\nax = world.plot(color='white', edgecolor='black')\ndf.plot(ax=ax, edgecolor='green', facecolor=\"green\", alpha=0.5, linewidth=1)\nax.set_xlim([-40,50])\nax.set_ylim([20,80])\nplt.show()","position":{"start":{"line":161,"column":1},"end":{"line":170,"column":1}},"key":"JpQTNfMVxC"},{"type":"image","url":"/STAC_EU-a94793e55aac154bc23e5060f27074ef.png","alt":"image","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"key":"T16WrWJtAV","urlSource":"../../_static/stac//STAC_EU.png"},{"type":"heading","depth":2,"position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"3. Load Data from the EODC STAC catalogue into Xarray","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"E1rjfYHhXD"}],"identifier":"id-3-load-data-from-the-eodc-stac-catalogue-into-xarray","label":"3. Load Data from the EODC STAC catalogue into Xarray","html_id":"id-3-load-data-from-the-eodc-stac-catalogue-into-xarray","implicit":true,"key":"MNxBYQ15k4"},{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"text","value":"In the ","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"Rm4cM46Wqi"},{"type":"link","url":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_LoadDataXarray.ipynb","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"text","value":"third notebook","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"HUfWmjIdKy"}],"urlSource":"https://github.com/eodcgmbh/eodc-examples/blob/main/demos/python-stac_LoadDataXarray.ipynb","data":{"kind":"file","org":"eodcgmbh","repo":"eodc-examples","reference":"main","file":"demos/python-stac_LoadDataXarray.ipynb","raw":"https://raw.githubusercontent.com/eodcgmbh/eodc-examples/main/demos/python-stac_LoadDataXarray.ipynb"},"internal":false,"protocol":"github","key":"PJ15hfYjZz"},{"type":"text","value":" is described how to load data into a Xarray.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"HlpvKwrOSA"}],"key":"fkxr443STa"},{"type":"paragraph","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"children":[{"type":"text","value":"First we need to set some parameters.","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"key":"y05jiJN8av"}],"key":"RpJwpDxpy9"},{"type":"code","lang":"","value":"crs = \"EPSG:4312\"\nres = 0.00018 # 20 meters in degree \nbands = [\"red\", \"nir\"]","position":{"start":{"line":181,"column":1},"end":{"line":185,"column":1}},"key":"cvMT7QrcJK"},{"type":"paragraph","position":{"start":{"line":187,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Then we can load our items into a Xarray, an array that sets labels in the form of dimensions, coordinates and attributes on top of raw NumPy-like multidimensional arrays.\nYou can get more information about Xarray in the ","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"yGiY7WccGs"},{"type":"link","url":"https://docs.xarray.dev/en/stable/index.html","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"children":[{"type":"text","value":"Xarray documentation","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"ay8iDXBwSG"}],"urlSource":"https://docs.xarray.dev/en/stable/index.html","key":"TurfwR2KK1"},{"type":"text","value":".","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"uXfw0KsKng"}],"key":"j6Yyfbej13"},{"type":"code","lang":"","value":"ds = odc_stac.load(items,\n                    crs=crs,\n                    resolution=res,\n                    bbox=bbox_aut,\n                    bands = bands,\n                    )","position":{"start":{"line":190,"column":1},"end":{"line":197,"column":1}},"key":"tAbjbPQ7GM"},{"type":"paragraph","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"children":[{"type":"text","value":"You can save the Xarray as a netCDF (and also load the netCDF into the notebook again).","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"key":"UhrnLruXBA"}],"key":"S1vQZxEY3D"},{"type":"code","lang":"","value":"ds.to_netcdf(\"./data/stac_xarray.nc\")","position":{"start":{"line":201,"column":1},"end":{"line":203,"column":1}},"key":"JUK2J2Z4Vu"},{"type":"code","lang":"","value":"nc_file = xr.open_dataset(\"./data/stac_xarray.nc\")","position":{"start":{"line":205,"column":1},"end":{"line":207,"column":1}},"key":"rPnOCnrRJh"},{"type":"paragraph","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"Here we want to calculate the NDVI and plot the results. You can also plot e.g. single Bands or a true colour image.","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"ozHwlw6vmk"}],"key":"AVmVeXkRqx"},{"type":"code","lang":"","value":"red = nc_file['red']\nnir = nc_file['nir']\n\ndef normalized_difference(x, y):\n    nd = (x - y) / (x + y)\n    return nd\n\nndvi = normalized_difference(nir, red)","position":{"start":{"line":211,"column":1},"end":{"line":220,"column":1}},"key":"oSXhhFioMx"},{"type":"paragraph","position":{"start":{"line":222,"column":1},"end":{"line":222,"column":1}},"children":[{"type":"text","value":"Then you can plot your NDVI Xarray.","position":{"start":{"line":222,"column":1},"end":{"line":222,"column":1}},"key":"MyRknotRiD"}],"key":"VGmsepw53G"},{"type":"code","lang":"","value":"p = plt.imshow(time_data, vmin = -1,  vmax = 1, cmap = \"inferno\")\nplt.colorbar(p)\nplt.xlabel(\"Longitude\")\nplt.ylabel(\"Latitude\")\nplt.title(\"NetCDF Data NDVI\")\nplt.show()","position":{"start":{"line":223,"column":1},"end":{"line":230,"column":1}},"key":"UEv1aUBL4U"},{"type":"image","url":"/STAC_XarrayPlot-a84b77cb518fd2ccd9d70a0eccf1b1e6.png","alt":"image","position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"key":"TpZUWrhqfm","urlSource":"../../_static/stac//STAC_XarrayPlot.png"}],"key":"grtiA2DS0l"}],"key":"Fj4dOwuNLr"},"references":{"cite":{"order":[],"data":{}}}}