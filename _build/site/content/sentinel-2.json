oration":"none","color":"#1d70b8","fontWeight":"bold"},"url":"/stac","children":[{"type":"text","value":"View Notebook","key":"ebB8FsvkOs"}],"urlSource":"stac.md","dataUrl":"/stac.json","internal":true,"protocol":"file","key":"rNUGY7yNxL"}],"key":"kxPHYiBmKK"}],"key":"l6Ym6RpNW9"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Read Sentinel-2 data from remote location","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"a8Ekrdi8do"}],"identifier":"read-sentinel-2-data-from-remote-location","label":"Read Sentinel-2 data from remote location","html_id":"read-sentinel-2-data-from-remote-location","implicit":true,"key":"RQ8GoWnHHo"},{"type":"code","lang":"python","value":"from pystac.extensions.eo import EOExtension as eo\nimport pystac_client\nimport planetary_computer\nfrom rich.console import Console\nconsole = Console()\n\ncatalog = pystac_client.Client.open(\n    \"https://planetarycomputer.microsoft.com/api/stac/v1\",\n    modifier=planetary_computer.sign_inplace,\n)","position":{"start":{"line":19,"column":1},"end":{"line":30,"column":1}},"key":"h31jbjWFnN"},{"type":"code","lang":"python","value":"time_range = \"2023-09-01/2023-09-21\"\n\n# GEOJSON can be created on geojson.io\narea_of_interest = {\n  \"coordinates\": [\n          [\n            [\n              14.631570827879642,\n              48.95580055524857\n            ],\n            [\n              14.631570827879642,\n              48.495695436823524\n            ],\n            [\n              15.727627794927486,\n              48.495695436823524\n            ],\n            [\n              15.727627794927486,\n              48.95580055524857\n            ],\n            [\n              14.631570827879642,\n              48.95580055524857\n            ]\n          ]\n        ],\n        \"type\": \"Polygon\"\n}","position":{"start":{"line":33,"column":1},"end":{"line":64,"column":1}},"key":"V3aXBjx3Y5"},{"type":"code","lang":"python","value":"search = catalog.search(\n    collections=[\"sentinel-2-l2a\"],\n    intersects=area_of_interest,\n    datetime=time_range,\n    query={\"eo:cloud_cover\": {\"lt\": 10},\n           \"s2:nodata_pixel_percentage\": {\"lt\": 20}},\n)\n\n# Check how many items were returned\nitems = search.item_collection()\nconsole.print(f\"Returned {len(items)} Items\")","position":{"start":{"line":67,"column":1},"end":{"line":79,"column":1}},"key":"GvJBt8NYGj"},{"type":"code","lang":null,"meta":null,"value":"Returned 14 Items","key":"p5Jx9m0I97"},{"type":"code","lang":"python","value":"least_cloudy_item = min(items, key=lambda item: eo.ext(item).cloud_cover)\n\nconsole.print(\n    f\"Choosing {least_cloudy_item.id} from {least_cloudy_item.datetime.date()}\"\n    f\" with {eo.ext(least_cloudy_item).cloud_cover}% cloud cover\"\n)","position":{"start":{"line":88,"column":1},"end":{"line":95,"column":1}},"key":"hFK8v2YLen"},{"type":"code","lang":null,"meta":null,"value":"Choosing S2A_MSIL2A_20230907T100031_R122_T33UWQ_20230907T211348 from 2023-09-07 with 0.000488% cloud cover","key":"vV5xgkp3Ig"},{"type":"code","lang":"python","value":"asset_href = least_cloudy_item.assets[\"visual\"].href","position":{"start":{"line":104,"column":1},"end":{"line":106,"column":1}},"key":"kcv2rvyeuL"},{"type":"code","lang":"python","value":"asset_href = items[10].assets[\"visual\"].href","position":{"start":{"line":109,"column":1},"end":{"line":111,"column":1}},"key":"x2nByITj9d"},{"type":"code","lang":"python","value":"import rasterio\nfrom rasterio import windows,features, warp, crs\n\nimport numpy as np\nfrom PIL import Image\n\nwith rasterio.open(asset_href) as ds:\n    aoi_bounds = features.bounds(area_of_interest)\n    warped_aoi_bounds = warp.transform_bounds(crs.CRS.from_epsg(4326), ds.crs, *aoi_bounds)\n    aoi_window = windows.from_bounds(transform=ds.transform, *warped_aoi_bounds)\n    band_data = ds.read(window=aoi_window)","position":{"start":{"line":114,"column":1},"end":{"line":126,"column":1}},"key":"v6pjWrfGSM"},{"type":"code","lang":"python","value":"img = Image.fromarray(np.transpose(band_data, axes=[1, 2, 0]))\nw = img.size[0]\nh = img.size[1]\naspect = w / h\ntarget_w = 800\ntarget_h = (int)(target_w / aspect)\nimg.resize((target_w, target_h), Image.Resampling.BILINEAR)","position":{"start":{"line":129,"column":1},"end":{"line":137,"column":1}},"key":"o2yplneuaC"},{"type":"image","url":"/Sentinel-2_8_0-bbaf104a120bde567407ff0ed542261e.png","alt":"png","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"KSTrjDLuVD","urlSource":"Sentinel-2_files/Sentinel-2_8_0.png"},{"type":"code","lang":"python","value":"","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"eyXLBFEo88"}],"key":"tVkbLWzPO5"}],"key":"KbcQNoKGSL"},"references":{"cite":{"order":[],"data":{}}}}