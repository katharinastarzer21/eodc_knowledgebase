Argo Workflows.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"MM3L0YPSJK"}],"key":"mf1FV7QKZH"}],"key":"We9TmKguxG"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"ARGO_WORKFLOWS_TOKEN. This is the token that will be used to authenticate with the Argo Workflows server.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"sTMMJnwJFj"}],"key":"OYGNwICTra"}],"key":"uWVutYALXd"}],"key":"vZj72Uzjeb"},{"type":"code","lang":"python","value":"from eodc.settings import settings\n\nsettings.FAAS_URL =\"https://services.eodc.eu/workflows/\"\nsettings.NAMESPACE = \"default\"\nsettings.ARGO_WORKFLOWS_TOKEN = \"\"","position":{"start":{"line":30,"column":1},"end":{"line":36,"column":1}},"key":"TYo3e0wwAc"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Within eodc.faas ther CustomWorkflow class makes use of the FaasProcessorBase that has a number of functions defined for interacting with Argo Workflow resources. We will use the eodc.faas.FaasProcessor.custom in order to instantiate a service connection that will allow us to submit an arbitrary Argo Workflow.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"JfjqhUaDIh"}],"key":"UVhSmi7w0T"},{"type":"code","lang":"python","value":"service = eodc.faas.CustomWorkflow(\n    processor_details=eodc.faas.FaasProcessor.custom\n)","position":{"start":{"line":43,"column":1},"end":{"line":47,"column":1}},"key":"XTMwqd7DCg"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Using ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"LnmPqRkTRP"},{"type":"link","url":"https://hera.readthedocs.io/en/stable/","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Hera","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Nvt1iorIiz"}],"urlSource":"https://hera.readthedocs.io/en/stable/","key":"MiphcU3YSG"},{"type":"text","value":", it is possible to define Argo Workflow resources in code. The following is an example resource taken from their documentation.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"AsHUT6WdKS"}],"key":"f4da1CvMly"},{"type":"code","lang":"python","value":"from hera.workflows import Container, Parameter, Step, Steps, Workflow, WorkflowsService\n\ndef hello(service: WorkflowsService):\n    with Workflow(\n        workflows_service=service,\n        namespace=service.namespace,\n        generate_name=\"steps-\",\n        entrypoint=\"hello-hello-hello\",\n    ) as w:\n        print_message = Container(\n            name=\"print-message\",\n            image=\"busybox\",\n            command=[\"echo\"],\n        )\n\n        with Steps(name=\"hello-hello-hello\") as s:\n            Step(\n                name=\"hello1\",\n                template=print_message,\n                arguments=[Parameter(name=\"message\", value=\"hello1\")],\n            )\n\n            with s.parallel():\n                Step(\n                    name=\"hello2a\",\n                    template=print_message,\n                    arguments=[Parameter(name=\"message\", value=\"hello2a\")],\n                )\n                Step(\n                    name=\"hello2b\",\n                    template=print_message,\n                    arguments=[Parameter(name=\"message\", value=\"hello2b\")],\n                )\n    return w","position":{"start":{"line":52,"column":1},"end":{"line":87,"column":1}},"key":"wBjpzbmrZU"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Once you have an Argo Workflow resource that is has been wrapped in a function that will passes the workflow service on instantiation. You will be able to submit it to the Argo Workflow server in the following way.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"GgOwU5uXVP"}],"key":"ddJU7sF2s3"},{"type":"code","lang":"python","value":"name = service.submit_workflow(\n    workflow=hello(service.workflows_service)\n)","position":{"start":{"line":92,"column":1},"end":{"line":96,"column":1}},"key":"cNfZL6wYjv"},{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"A number of functions are available via the eodc-sdk to monitor and interact with Argo Workflows. To get the workflow logs, we can use the .get_logs() function.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"WO57oPNwqg"}],"key":"LWfCxj1TMB"},{"type":"code","lang":"python","value":"service.get_logs(name)","position":{"start":{"line":101,"column":1},"end":{"line":103,"column":1}},"key":"qetzTetHnS"}],"key":"nfQeqYhVQ9"}],"key":"PYJOielxum"},"references":{"cite":{"order":[],"data":{}}}}