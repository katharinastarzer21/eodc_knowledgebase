{"version":2,"kind":"Article","sha256":"e17e1962901aaf93d11bc97c212be1fe09ca95f7fe299203bffc29f2dd68e659","slug":"wfs","location":"/source/tutorials/wfs.md","dependencies":[],"frontmatter":{"title":"Web Feature Services (WFS)","content_includes_title":false,"numbering":{"title":{"offset":1}},"thumbnail":"/wfs_newCon-ad66385aed7500b49ef68d9bfd7d03cd.png","exports":[{"format":"md","filename":"wfs.md","url":"/wfs-59f561b6844c27d37cf150de9eb6858c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Using EGMS as Web Feature Services (WFS)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PdM776gWxZ"}],"key":"F2uAN4GYTy"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Overview","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"LlHd9T5ubn"}],"identifier":"overview","label":"Overview","html_id":"overview","implicit":true,"key":"sVG2jOummv"},{"type":"heading","depth":3,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Web Feature Service (WFS)","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"HZhlyzmLZq"}],"identifier":"web-feature-service-wfs","label":"Web Feature Service (WFS)","html_id":"web-feature-service-wfs","implicit":true,"key":"T4qRWkynHP"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Web Feature Services (WFS) are another way of providing access to geodata. In contrast to Web Map Services (WMS), WFS only returns objects with geometry and attributes and not entire images. WFS objects can also be limited by a spatial extent or by attributes.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"rMZNWJ1Gwz"}],"key":"OiLRZP4dBV"},{"type":"heading","depth":3,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Ground Motion Service","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"rMo6dPUch7"}],"identifier":"ground-motion-service","label":"Ground Motion Service","html_id":"ground-motion-service","implicit":true,"key":"fChUy3wDxr"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Detecting ground and mass movements requires continuous monitoring and evaluation of current as well as historical data.\nIn this service, advanced differential SAR interferometry (DInSAR) techniques are applied to Sentinel-1 radar satellite imagery to derive ground and mass movements.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"rg7jEIBHw1"}],"key":"iBjUXkebwN"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The service processes data from the European Ground Motion Service ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"UaSN8a1Tun"},{"type":"link","url":"https://egms.land.copernicus.eu/","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"EGMS","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Uhjs0PXUZa"}],"urlSource":"https://egms.land.copernicus.eu/","key":"EYtRmOAlpY"},{"type":"text","value":" on the one hand, and the Subsidence and Landslide Monitoring Service Austria ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"ZlLW1bXW1O"},{"type":"link","url":"https://sims.sen2cube.at","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"SuLaMoSA","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"QAt8YzrVn5"}],"urlSource":"https://sims.sen2cube.at","key":"QxbxazqpAw"},{"type":"text","value":", prototype developed in ASAP-14, on the other hand.\nBoth services provide time series of east-west displacement and high-low movement for evaluable points, i.e. points that do not significantly change their radar backscatter properties over time. The spatial resolution for EGMS is ~100x100 m² and is currently available for the period 2016-2020. For SuLaMoSA, the parameters of spatial and temporal coverage can be freely selected.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"nLlvYdKycH"}],"key":"Fdl6ObLVdc"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Use cases","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"rZsfmZflOR"}],"identifier":"use-cases","label":"Use cases","html_id":"use-cases","implicit":true,"key":"Mh6SE2QeXv"},{"type":"heading","depth":3,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"WFS in QGIS","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"nIQ0eHna3f"}],"identifier":"wfs-in-qgis","label":"WFS in QGIS","html_id":"wfs-in-qgis","implicit":true,"key":"YO39fwmNOx"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"WFS data can be displayed and analyzed with the help of a geographic information system (GIS). The most popular GIS is QGIS and in ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"yRqaxGrp6g"},{"type":"link","url":"https://interface.eodc.eu/de/interface-massgeschneiderte-services-nutzen.html","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"this article","position":{"start":{"line":25,"column":1},"end"