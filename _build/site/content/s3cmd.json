th an lifecycle or expiration policy.\nThis policy allows for automatic removal of objects based on desired criteria.\nThese policies can be configured on a per-bucket or per-object basis.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"gnyQzSaTwL"}],"key":"ka71EqnsKF"},{"type":"heading","depth":4,"position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Example Policy","position":{"start":{"line":150,"column":1},"end":{"line":150,"column":1}},"key":"ke1D8fF6pi"}],"identifier":"example-policy","label":"Example Policy","html_id":"example-policy","implicit":true,"key":"pVSiZ5yoHj"},{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Relative:\nHere a policy is set that objects are automatically expired 14 days after they are created.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"vzz4kXOH3Y"}],"key":"wVacxdsze0"},{"type":"code","lang":"","value":"[host]$ s3cmd expire s3://bucket --expiry-days 14\nBucket 's3://bucket/': expiration configuration is set.\n\n[host]$ s3cmd getlifecycle s3://bucket\n<?xml version=\"1.0\" ?>\n<LifecycleConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n        <Rule>\n                <ID>4sgzpl003evke1w66xl6czjixxq0wfvq7vhq89mu72v273tb</ID>\n                <Prefix/>\n                <Status>Enabled</Status>\n                <Expiration>\n                        <Days>14</Days>\n                </Expiration>\n        </Rule>\n</LifecycleConfiguration>","position":{"start":{"line":155,"column":1},"end":{"line":171,"column":1}},"key":"qZGzXay9kP"},{"type":"paragraph","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"children":[{"type":"text","value":"Note that attempting to view the policy of a bucket without a configured policy will return a 404.","position":{"start":{"line":174,"column":1},"end":{"line