r collection, we have to first find out the collection id, we can do this by listing the stac collections within the workspace using\nthe list_stac_collections(WORKSPACE_NAME) function. This function returns us a list of tuples consisting of the collection_id and the path to the stac collection json.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CTrv89p3FZ"}],"key":"k94r1scEoI"}],"key":"dqoIXkwxMi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from eodc.workspace import CephAdapter, EODC_CEPH_URL\n\n# Set these variables to your own.\n\nWORKSPACE_NAME = \"\"\n\nS3_ENDPOINT = EODC_CEPH_URL\nS3_ACCESS_KEY = \"\"\nS3_SECRET_KEY = \"\"\n\nadapter: CephAdapter = CephAdapter(S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY)\n\ncollections = adapter.list_stac_collections(WORKSPACE_NAME)\n\ncollections","key":"JpYnbXHuJp"},{"type":"output","id":"VMBm_NV80lEsXtQJStiDg","data":[],"key":"qubJFW5N4S"}],"key":"iZ5iHtrFT6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now you can set your url manually or get it via the list_stac_collections return value.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"inbgXxitza"}],"key":"ci8PlCIVQH"}],"key":"vGx4cDfQ1W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# URL = \"\"\n\ncollection_id = collections[0][0]\n\ncollection = collections[0][-1]\n\nURL = collection.links[1].absolute_href\n\nURL","key":"Hi8Df4QSbk"},{"type":"output","id":"mslAqYYtxHJ3NFPuTpghJ","data":[],"key":"HkQ9rplYNU"}],"key":"FQQHDnJJj6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"You can also check the available STAC items of your given collection beforehand by using the get_stac_items function of the workspace adapter.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZzIHEV9V41"}],"key":"g8fZS2wKba"}],"key":"BSfs89eKhf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"items = adapter.get_stac_items(workspace_name=WORKSPACE_NAME, collection_id=collection_id)\n\nitems","key":"BJyXW2spIa"},{"type":"output","id":"DWFdeY2B_movPcBNyPe9A","data":[],"key":"ZJbC7veuh7"}],"key":"hABf3LJvVX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We are also defaulting to the same spatial_extent and the same temporal_extent as in the save result notebook, feel free to change these to fit your use case.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M2bWA0tcxR"}],"key":"fU9coEMw9F"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"If you want to check the full extent of your user collection you can use the following code:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HrlV9qzvXa"}],"key":"TJyASaLbRi"}],"key":"c5rTjUXHBF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(adapter.get_collection(WORKSPACE_NAME, collection_id).extent.spatial.bboxes) # This prints the maximum bounding box around all items in the STAC collection\nprint(adapter.get_collection(WORKSPACE_NAME, collection_id).extent.temporal.intervals) # This prints the maximum temporal extent of all items in the STAC collection","key":"lfZbGL2zMx"},{"type":"output","id":"dLychc7N2IEI5hEwqC-My","data":[],"key":"RYexTQHrHT"}],"key":"rxc69kYyis"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now we can start a job with the corresponding url in the load_stac node.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VIiUgJgLPy"}],"key":"KBemtyia0b"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This will load results from a previous job which we can then further transform and use as we like.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r0QOmby4Pd"}],"key":"QKDhqKdYmo"}],"key":"gMGVhm2bFs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"collection = connection.load_stac(\n    url=URL,\n    spatial_extent={\n        \"west\": 16.156771491786476,\n        \"east\": 16.59018048465475,\n        \"south\": 48.08419286799747,\n        \"north\": 48.34670064966687,\n    },\n    temporal_extent=[\"2019-01-01T00:00:00Z\", \"2019-01-31T00:00:00Z\"]\n)\n\nresult = collection.save_result(format=\"netCDF\")","key":"cwAuUka7xs"},{"type":"output","id":"GXPFi-Tn8jw7grnvB0fK9","data":[],"key":"PCRslSxTYT"}],"key":"IarthJqHrF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Run this to start the job.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BdB5ZbwzGP"}],"key":"EWxI3UDXVu"}],"key":"rTseuy02eE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"job = result.create_job()\n\njob.start()","key":"FStW7fFM34"},{"type":"output","id":"p8bmeRuvquqcV2hiCBHtT","data":[],"key":"DzYdCh8SSp"}],"key":"Pt6Uf1mz29"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},